{
  "name": "orion6-robotic-arm",
  "version": "1.0.0",
  "private": true,
  "description": "ORION-6 : bras robotique 6 axes open-source imprimable en 3D + ORION Studio (simulateur, réglages, contrôle).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node tools/serve.mjs",
    "vendor": "node tools/vendor.mjs",
    "build:cad": "node tools/build-cad.mjs",
    "build:docs": "node tools/gen-docs.mjs",
    "build:app": "node tools/build-app.mjs",
    "build:firmware-config": "node tools/gen-firmware-config.mjs",
    "build": "npm run vendor && npm run build:cad && npm run build:docs && npm run build:firmware-config && npm run build:app",
    "test:firmware": "make -C firmware/test",
    "build:firmware": "bash tools/build-teensy.sh"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "manifold-3d": "^3.5.4",
    "three": "^0.186.1"
  },
  "engines": {
    "node": ">=20"
  }
}
